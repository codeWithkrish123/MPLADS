# MPLADS Frontend Environment Configuration
# Copy to .env and configure for your environment

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=5000

# Environment
VITE_ENV=development
VITE_DEBUG=true

# Feature Flags
VITE_FEATURE_PERFORMANCE_MONITORING=true
VITE_FEATURE_ERROR_TRACKING=false
VITE_FEATURE_ANALYTICS=false

# External Services
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=

# Map Configuration (if using Leaflet)
VITE_MAP_API_KEY=

# i18n Configuration
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,hi

# Performance Configuration
VITE_PERF_MONITORING_ENABLED=true
VITE_PERF_PROFILING_ENABLED=true
VITE_PERF_LOG_THRESHOLD_MS=100

# Cache Configuration
VITE_CACHE_STRATEGY=memory
VITE_CACHE_MAX_SIZE=500
VITE_CACHE_TTL_DEFAULT=300000

# Build Configuration
VITE_BUILD_TARGET=es2020
VITE_MINIFY=true
VITE_SOURCE_MAP=false
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
