// MPLADS Sentinel - Prisma Schema
// PostgreSQL Database Schema for Backend State Management & Audit System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------------

enum Role {
  MINISTRY
  STATE_NODAL
  DISTRICT_AUTHORITY
  MP
  CITIZEN
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  DISMISSED
}

enum DuplicateStatus {
  REQUIRES_HUMAN_REVIEW
  CONFIRMED_DUPLICATE
  FALSE_POSITIVE
  RESOLVED
}

enum RuleCategory {
  FINANCIAL
  IMPLEMENTATION
  COMPLIANCE
  PROCUREMENT
  TECHNICAL
  ANOMALY
}

enum RuleStatus {
  ACTIVE_POLICY
  DRAFT
  ARCHIVED
  UNDER_REVIEW
}

// -------------------------------------------------------------------
// MODELS
// -------------------------------------------------------------------

/// Government Administrative Users & Role-Based Access Control
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(CITIZEN)
  state        String?
  district     String?
  constituency String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

/// Discrepancy & Risk Detection Alerts generated by Sentinel ML & Rules Engine
model RiskAlert {
  id           String      @id @default(uuid())
  workId       String      @map("work_id")
  workName     String      @map("work_name")
  state        String
  district     String
  category     String
  severity     Severity
  riskScore    Float       @map("risk_score")
  anomalyType  String      @map("anomaly_type")
  reason       String
  status       AlertStatus @default(OPEN)
  assignedToId String?     @map("assigned_to_id")
  detectedAt   DateTime    @default(now()) @map("detected_at")
  resolvedAt   DateTime?   @map("resolved_at")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("risk_alerts")
}

/// Near-Duplicate Project Review Pairs detected by NLP & Geospatial Analysis
model NearDuplicateReview {
  id                String          @id @default(uuid())
  workAId           String          @map("work_a_id")
  workBId           String          @map("work_b_id")
  workAName         String          @map("work_a_name")
  workBName         String          @map("work_b_name")
  state             String?
  district          String?
  similarityScore   Float           @map("similarity_score")
  geoDistanceMeters Float?          @map("geo_distance_meters")
  status            DuplicateStatus @default(REQUIRES_HUMAN_REVIEW)
  reviewerId        String?         @map("reviewer_id")
  reviewNotes       String?         @map("review_notes")
  reviewedAt        DateTime?       @map("reviewed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("near_duplicate_reviews")
}

/// Cryptographically Hashed Immutable Audit Ledger
model AuditLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  userId        String?  @map("user_id")
  userName      String   @map("user_name")
  role          String
  action        String
  entity        String
  entityId      String   @map("entity_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  status        String   @default("LOGGED")
  hashSignature String   @map("hash_signature")
  prevHash      String?  @map("prev_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

/// Statutory Compliance Policies & Anomaly Threshold Rules
model ComplianceRule {
  id                   String       @id @default(uuid())
  ruleId               String       @unique @map("rule_id")
  title                String
  category             RuleCategory
  affectedWorksCount   Int          @default(0) @map("affected_works_count")
  severity             Severity
  status               RuleStatus   @default(ACTIVE_POLICY)
  policyVersion        String       @default("1.0") @map("policy_version")
  effectiveDate        DateTime     @map("effective_date")
  sourceDocument       String       @map("source_document")
  policyStatement      String?      @map("policy_statement")
  thresholdDescription String       @map("threshold_description")
  detectionLogic       String       @map("detection_logic")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at")

  @@map("compliance_rules")
}

/// Implementing Agencies (PWD, RWD, PHED, etc.) Performance & Risk Metrics
model ImplementingAgency {
  id                  String   @id @default(uuid())
  agencyCode          String   @unique @map("agency_code")
  name                String
  shortName           String   @map("short_name")
  type                String
  state               String
  district            String?
  riskCategory        Severity @default(LOW) @map("risk_category")
  avgRiskScore        Float    @default(0) @map("avg_risk_score")
  totalWorks          Int      @default(0) @map("total_works")
  completedWorks      Int      @default(0) @map("completed_works")
  delayedWorks        Int      @default(0) @map("delayed_works")
  highRiskWorks       Int      @default(0) @map("high_risk_works")
  activeExpenditureCr Float    @default(0) @map("active_expenditure_cr")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("implementing_agencies")
}

/// Lok Sabha & Rajya Sabha MP Fund Entitlements and Allocations (543 MPs)
model MPAllocation {
  id              String   @id @default(uuid())
  srNo            Int      @map("sr_no")
  state           String
  mpName          String   @map("mp_name")
  constituency    String
  allocatedAmount Float    @map("allocated_amount")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("mp_allocations")
}

/// MP Calamity Relief & Natural Disaster Contribution Consents
model CalamityConsent {
  id            String   @id @default(uuid())
  srNo          Int      @map("sr_no")
  calamityType  String   @map("calamity_type")
  calamityName  String   @map("calamity_name")
  mpName        String   @map("mp_name")
  consentDate   DateTime @map("consent_date")
  consentAmount Float    @map("consent_amount")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("calamity_consents")
}
